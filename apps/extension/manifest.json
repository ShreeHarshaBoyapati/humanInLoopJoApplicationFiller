{
  "manifest_version": 3,
  "name": "Job Filler",
  "description": "A Chrome extension to fill job applications",
  "version": "1.0.0",
  "oauth2": {
    "client_id": "PLACEHOLDER_EXTENSION_CLIENT_ID",
    "scopes": [
      "openid",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "action": {
    "default_icon": {
      "16": "public/icon-16.png",
      "32": "public/icon-32.png",
      "48": "public/icon-48.png",
      "128": "public/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "./src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/job-listing/*",
        "*://*.glassdoor.co.in/job-listing/*",
        "*://*.naukri.com/*",
        "*://*.lever.co/*",
        "*://*.greenhouse.io/*"
      ],
      "js": ["./src/content/quick-save.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "identity"],
  "icons": {
    "16": "public/icon-16.png",
    "32": "public/icon-32.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://localhost:3001/*",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.glassdoor.com/*",
    "*://*.glassdoor.co.in/*",
    "*://*.naukri.com/*",
    "*://*.lever.co/*",
    "*://*.greenhouse.io/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["public/icon-48.png"],
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.naukri.com/*",
        "*://*.lever.co/*",
        "*://*.greenhouse.io/*"
      ]
    }
  ]
}
