# ================================
# Environment Variables Template
# ================================
# Copy this file to .env and fill in your values
# DO NOT commit .env files with real secrets!

# ----- API Server -----
NODE_PORT=8000
NODE_ENV=development
NODE_DATABASE_CONFIG='{"host":"","username":"","password":"","database":"","port":5432}'
# Comma-separated for multiple origins: http://localhost:3000,https://example.com
NODE_CORS_ORIGIN='http://localhost:3000,http://localhost:3001'
NODE_JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
NODE_JWT_EXPIRES_IN=7d
NODE_RATE_LIMIT_MAX=100

# ----- Google OAuth2 -----
NODE_GOOGLE_CLIENT_ID=your-google-client-id
NODE_GOOGLE_CLIENT_SECRET=your-google-client-secret
NODE_GOOGLE_REDIRECT_URI=http://localhost:8000/api/user/google/callback

# ----- Gmail SMTP -----
NODE_GMAIL_USER=your-gmail@gmail.com
NODE_GMAIL_APP_PASSWORD=your-16-char-app-password

# ----- Frontend (Vite) -----
# Note: Vite requires VITE_ prefix to expose to browser
VITE_WEB_BACKENDAPI=http://localhost:8000/api
VITE_APP_NAME=JFP App
# WebSocket URL for realtime sync (Checkpoint 3). Falls back to same-origin in prod.
VITE_WS_URL=ws://localhost:8000/ws
# Transit encryption secret shared with backend/extension. Must match TRANSIT_SECRET in prod.
VITE_TRANSIT_SECRET=jfp-default-transit-secret-change-in-prod

# ----- Extension -----
# Web app URL for Chrome extension content script matching and auth sync
VITE_WEB_APP_URL=http://localhost
VITE_WEB_APP_PORT=3001
# Chrome Extension OAuth Client ID (from Google Cloud Console - Chrome Extension type)
VITE_EXT_CLIENT_ID=your-chrome-extension-client-id.apps.googleusercontent.com
VITE_EXT_BACKENDAPI=http://localhost:8000/api
# WebSocket URL for extension realtime sync (Checkpoint 4). Background SW opens this.
VITE_EXT_WS_URL=ws://localhost:8000/ws
