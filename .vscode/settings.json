{
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "stylelint.validate": ["css", "scss"],
  "css.validate": false,
  "scss.validate": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "cSpell.words": ["naukri", "ollama"]
}
